DOMAIN=termine.example.de
ACME_EMAIL=admin@example.de

# Optional: eigener Einrichtungscode statt des automatisch erzeugten (gilt nur für das erste Konto).
# Der automatische Code steht im Log: docker compose logs termind | grep setup
# SETUP_TOKEN=ein-langer-zufaelliger-text

# Nur wenn dein Mail-Server oder Kalender im lokalen Netz steht (z. B. eigenes Relay, Nextcloud im LAN).
# Dann zusätzlich in docker-compose.yml unter environment eintragen: ALLOW_PRIVATE_HOSTS: ${ALLOW_PRIVATE_HOSTS:-}
# ALLOW_PRIVATE_HOSTS=true
