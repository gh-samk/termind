{
  "name": "termind",
  "version": "0.1.0",
  "description": "Schlanke, selbst hostbare Terminbuchung mit MCP-Schnittstelle",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "ALLOW_PRIVATE_HOSTS=true CALENDAR_SYNC_MINUTES=1 PORT=3317 PUBLIC_URL=http://localhost:5173 tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite --port 5173 --strictPort",
    "build": "vite build && tsup",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "ical.js": "^2.2.1",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "tsdav": "^2.5.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
